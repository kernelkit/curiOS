#!/usr/bin/env python3
"""Add a HEALTHCHECK to an OCI image built by sloci-image.

sloci-image writes a conforming OCI image but knows nothing about
Healthcheck, which is a Docker extension to the image configuration
that podman honours too.  Adding it means rewriting the config blob
and re-pointing the manifest and index at the new digests.
"""
import argparse
import hashlib
import json
import os
import sys


def blob_path(oci, digest):
    algo, hexd = digest.split(":", 1)
    return os.path.join(oci, "blobs", algo, hexd)


def read_blob(oci, digest):
    with open(blob_path(oci, digest), "rb") as fh:
        return json.loads(fh.read())


def write_blob(oci, obj):
    """Write obj as a blob, returning its descriptor digest and size."""
    raw = json.dumps(obj, separators=(",", ":"), sort_keys=False).encode()
    digest = "sha256:" + hashlib.sha256(raw).hexdigest()
    path = blob_path(oci, digest)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as fh:
        fh.write(raw)
    return digest, len(raw)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("oci", help="OCI image directory (rootfs-oci)")
    ap.add_argument("spec", help="healthcheck JSON file")
    args = ap.parse_args()

    with open(args.spec, encoding="utf-8") as fh:
        hc = json.load(fh)

    if not hc.get("Test"):
        sys.exit("ERROR: %s has no Test" % args.spec)

    index_path = os.path.join(args.oci, "index.json")
    with open(index_path, encoding="utf-8") as fh:
        index = json.load(fh)

    stale = set()
    live = set()

    for desc in index["manifests"]:
        manifest = read_blob(args.oci, desc["digest"])
        stale.add(desc["digest"])
        stale.add(manifest["config"]["digest"])

        config = read_blob(args.oci, manifest["config"]["digest"])
        config.setdefault("config", {})["Healthcheck"] = hc

        digest, size = write_blob(args.oci, config)
        manifest["config"]["digest"] = digest
        manifest["config"]["size"] = size
        live.add(digest)

        digest, size = write_blob(args.oci, manifest)
        desc["digest"] = digest
        desc["size"] = size
        live.add(digest)

    with open(index_path, "w", encoding="utf-8") as fh:
        json.dump(index, fh, separators=(",", ":"))

    # A blob can be shared between manifests, so only drop the ones
    # nothing points at any more.
    for digest in stale - live:
        try:
            os.unlink(blob_path(args.oci, digest))
        except OSError:
            pass

    print("  Healthcheck  : %s" % " ".join(hc["Test"]))


if __name__ == "__main__":
    main()
